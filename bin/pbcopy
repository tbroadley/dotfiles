#!/bin/bash
# Copies stdin to the host clipboard via url-listener.
# Used in dev containers to forward clipboard operations to macOS host.

# Sibling scripts live next to this one, wherever it was symlinked from.
_bindir="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd)"

if [ -f /.dockerenv ] || [ -n "${REMOTE_CONTAINERS:-}" ]; then
  BASE="$("$_bindir/url-listener-url")" || exit 1
  TOKEN="$("$_bindir/url-listener-token")" || exit 1
  curl -fsS --connect-timeout 2 --max-time 5 \
    -K <(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN") \
    --data-binary @- "${BASE}/copy" >/dev/null
else
  exec /usr/bin/pbcopy
fi
