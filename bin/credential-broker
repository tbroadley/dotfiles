#!/usr/bin/env python3
"""Release one vault field to one command on a remote host, with my approval.

The other half of `with-secret`. That script runs on a machine I let agents work
on; this one runs on my laptop, where the Bitwarden vault is. The remote machine
holds no credentials at all — it holds a bearer token that lets it *ask*, which
is worth nothing on its own.

    box                                     laptop (this)
     |  POST /request {field, argv, ...}      |
     |--------------------------------------->|  bearer token?
     |                                        |  field known?
     |                                        |  argv allowed for that field?
     |                                        |  no shell wrappers, no metachars?
     |                                        |  --> any no: 403, logged, no prompt
     |                                        |  recent identical approval? --> reuse
     |                                        |  otherwise: notify + confirm dialog
     |                                        |  --> deny or timeout: 403 / 408
     |                                        |  unlock vault, read ONE field
     |<---------------------------------------|  200 {value, ttl}

Two things are deliberate:

* There is no endpoint that returns a value without a command attached. The
  remote side cannot ask "what is DD_PAT", only "run this exact command with
  it", and the answer is a value that its own tooling never prints.

* The allowlist of which commands may use which field lives here, on the machine
  the agents cannot write to. If it lived on the box, an agent could edit it, and
  an agent that has read a malicious PR comment is exactly the thing this is for.

What it does NOT defend against, and should not be sold as defending against: a
box where someone has already put their own `pup` earlier on PATH. The allowlist
constrains the *name* of the command, and the name is chosen over there. It
bounds mistakes and makes the approval prompt meaningful; it is not a sandbox.
The fix for that is proxy mode — the laptop makes the API call — which is worth
building for a credential dangerous enough to deserve it.

Usage: credential-broker [--port N] [--bind ADDR] [--check]

Configuration, ~/.config/credential-broker.env (mode 0600), environment wins:

    CREDENTIAL_BROKER_TOKEN=<shared bearer token, >= 32 chars>
    CREDENTIAL_BROKER_PORT=7078
    CREDENTIAL_BROKER_BIND=<address to bind; default: this host's tailnet IP>
    CREDENTIAL_BROKER_ITEM=<Bitwarden item holding the fields>
    CREDENTIAL_BROKER_GRANT_TTL=60      seconds an approval covers a repeat
    CREDENTIAL_BROKER_SESSION_TTL=900   seconds the unlocked vault is kept
    CREDENTIAL_BROKER_POLICY=<path to a policy JSON file, optional>
    CREDENTIAL_BROKER_VAULT_FIELD_<NAME>=<field in the vault item, if it is not
                                          called the same thing as the variable>
    DD_SITE=<datadog site, for the curl rule>
"""

import argparse
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import threading
import time
import urllib.parse
from collections import deque
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path.home()
CONFIG_PATH = Path(os.environ.get("CREDENTIAL_BROKER_CONFIG", HOME / ".config/credential-broker.env"))
DEFAULT_AUDIT = HOME / "Library/Logs/credential-broker-audit.jsonl"
GUI_PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Commands that are not a command so much as a way of running any other command.
# Allowlisting one of these allowlists everything, so they are refused as argv[0]
# whatever the policy says. Checked by basename, and argv[0] may not be a path.
SHELL_WRAPPERS = {
    "sh", "bash", "zsh", "dash", "ash", "ksh", "mksh", "fish", "csh", "tcsh",
    "busybox", "env", "xargs", "nohup", "setsid", "time", "nice", "ionice",
    "timeout", "watch", "sudo", "doas", "su", "runuser", "chroot", "flock",
    "parallel", "script", "stdbuf", "unbuffer", "expect", "screen", "tmux",
    "ssh", "scp", "sftp", "rsync", "socat", "nc", "ncat", "telnet",
    "python", "python2", "python3", "perl", "ruby", "node", "deno", "bun",
    "php", "lua", "tclsh", "osascript", "open", "xdg-open",
    "awk", "gawk", "mawk", "nawk", "sed", "find", "make", "cmake", "just",
    "npm", "npx", "yarn", "pnpm", "bunx", "uv", "uvx", "pipx", "poetry",
    "docker", "podman", "kubectl", "helm", "git", "gh", "systemd-run", "at",
    "cron", "crontab", "eval", "exec", "command", "builtin", "source",
}

# Only meaningful if something re-evaluates argv through a shell, which
# `with-secret` does not — it execs directly. They are refused anyway because an
# argument that looks like shell is either a mistake about how this works or an
# attempt to make the approval prompt read as something other than what runs.
#
# Substrings, refused wherever they appear. No legitimate query needs them.
SHELLISH = ("$(", "${", "`", ";")
# Whole arguments that are shell punctuation. Only checked as whole arguments,
# because Datadog's own query syntax uses `>` and `<` inside a term
# (`@duration:>1000`), and refusing those would push people back to a bare shell
# and out of the broker entirely.
SHELL_TOKENS = {">", ">>", "<", "<<", "|", "||", "&", "&&", "2>", "&>", "&>>", "1>", "2>&1"}

CONTROL_CHARS = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")

MAX_ARGV = 64
MAX_ARG_LEN = 4096
MAX_ARGV_LEN = 8192
RATE_LIMIT = (20, 60)  # at most 20 requests per 60 seconds, before any prompt


def log(message):
    print(f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {message}", file=sys.stderr, flush=True)


# --- configuration -------------------------------------------------------------


def read_config():
    """Environment first, then the config file. Refuses a loose file mode."""
    config = {}
    if CONFIG_PATH.is_file():
        mode = CONFIG_PATH.stat().st_mode & 0o077
        if mode:
            sys.exit(
                f"credential-broker: {CONFIG_PATH} is group- or world-readable and holds a\n"
                f"bearer token. Run: chmod 600 {CONFIG_PATH}"
            )
        for line in CONFIG_PATH.read_text().splitlines():
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip()
    config.update({k: v for k, v in os.environ.items() if k.startswith("CREDENTIAL_BROKER_")})
    if "DD_SITE" in os.environ:
        config.setdefault("DD_SITE", os.environ["DD_SITE"])
    return config


def default_policy(config):
    """Which commands may see which field.

    Stage 1 is DD_PAT only. `pup` is the Datadog CLI and takes the token from the
    environment. `curl` is here under protest: pup covers a fraction of the API,
    and the alternative is that the documented fallback stops working and people
    route around the broker. It is constrained hard — one URL, https, exactly the
    Datadog API host for my site, and a closed set of flags, so it cannot be
    pointed at an attacker's collector, cannot read a file off the box with
    `-d @path`, cannot write one with `-o`, cannot take extra arguments from a
    `--config` file the broker never sees, and cannot follow a redirect somewhere
    else while still carrying the Authorization header.
    """
    policy = {"DD_PAT": [{"command": "pup"}]}
    site = config.get("DD_SITE", "").strip()
    if site:
        policy["DD_PAT"].append({"command": "curl", "hosts": [f"api.{site}"]})
    else:
        log("DD_SITE is not set, so the curl rule for DD_PAT is disabled (pup only).")
    return policy


def load_policy(config):
    policy = default_policy(config)
    path = config.get("CREDENTIAL_BROKER_POLICY")
    if path:
        override = json.loads(Path(path).expanduser().read_text())
        if not isinstance(override, dict):
            sys.exit("credential-broker: the policy file must be a JSON object of field -> rules")
        policy = override
    for field, rules in policy.items():
        for rule in rules:
            name = rule.get("command", "")
            if not name or "/" in name:
                sys.exit(f"credential-broker: bad command {name!r} in the policy for {field}")
            if name in SHELL_WRAPPERS:
                sys.exit(
                    f"credential-broker: the policy allows {name!r} for {field}, which is a way of "
                    "running any command at all. Refusing to start."
                )
    return policy


# --- argv checking ---------------------------------------------------------------


class Refused(Exception):
    """Refused before any human was bothered. The message goes back to the box."""


def check_generic(field, argv):
    if not argv:
        raise Refused("no command given")
    if len(argv) > MAX_ARGV:
        raise Refused(f"too many arguments ({len(argv)} > {MAX_ARGV})")
    if sum(len(a) for a in argv) > MAX_ARGV_LEN:
        raise Refused("the command line is too long to show on an approval prompt")
    for arg in argv:
        if not isinstance(arg, str):
            raise Refused("arguments must be strings")
        if len(arg) > MAX_ARG_LEN:
            raise Refused("an argument is too long")
        if CONTROL_CHARS.search(arg):
            raise Refused("an argument contains control characters or newlines")
        if f"${field}" in arg:
            raise Refused(
                f"an argument contains ${field}. Nothing expands that: with-secret runs the "
                f"command without a shell. Write the placeholder {{{{{field}}}}} instead."
            )
        for token in SHELLISH:
            if token in arg:
                raise Refused(f"an argument contains {token!r}, which reads as shell")
        if arg in SHELL_TOKENS:
            raise Refused(f"{arg!r} is shell punctuation, not an argument; there is no shell here")
    if "/" in argv[0]:
        raise Refused("the command must be a bare name, not a path")
    if argv[0] in SHELL_WRAPPERS:
        raise Refused(f"{argv[0]} can run any command, so it is never allowed to hold a credential")


def find_rule(policy, field, argv):
    rules = policy.get(field)
    if rules is None:
        raise Refused(f"{field} is not a field this broker knows about")
    for rule in rules:
        if rule["command"] == argv[0]:
            return rule
    allowed = ", ".join(sorted(r["command"] for r in rules))
    raise Refused(f"{argv[0]} is not on the allowlist for {field} (allowed: {allowed})")


# curl flags that are safe for a request that carries a credential. Anything not
# listed is refused, so a new curl feature is refused by default rather than
# quietly allowed. Notable exclusions: -o/-O (write files), -K/--config (read
# arguments from a file this broker never sees), -x/--proxy, -L/--location
# (custom headers follow the redirect), -T/-F (upload), -k/--insecure,
# --unix-socket, --resolve/--connect-to (point a hostname anywhere), --netrc.
CURL_NO_ARG = {
    "-s", "--silent", "-S", "--show-error", "-f", "--fail", "--fail-with-body",
    "-G", "--get", "-i", "--include", "-v", "--verbose", "--compressed",
    "--no-progress-meter", "--http1.1", "--http2", "-g", "--globoff",
}
CURL_WITH_ARG = {
    "-X", "--request", "-H", "--header", "-d", "--data", "--data-raw",
    "--data-binary", "--data-urlencode", "--json", "--url", "--max-time",
    "--connect-timeout", "-A", "--user-agent", "--retry",
}
CURL_DATA_FLAGS = {"-d", "--data", "--data-raw", "--data-binary", "--data-urlencode", "--json"}


def check_curl(rule, argv):
    """Parse curl's argv well enough to know where the request is going."""
    hosts = {h.lower() for h in rule.get("hosts", [])}
    if not hosts:
        raise Refused("no allowed hosts configured for curl")

    urls = []
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            urls.extend(argv[index + 1:])
            break
        if arg.startswith("--"):
            flag, _, inline = arg.partition("=")
            if flag in CURL_NO_ARG:
                if inline:
                    raise Refused(f"curl flag {flag} does not take a value")
                index += 1
                continue
            if flag not in CURL_WITH_ARG:
                raise Refused(f"curl flag {flag} is not allowed when a credential is involved")
            if inline:
                value = inline
                index += 1
            else:
                if index + 1 >= len(argv):
                    raise Refused(f"curl flag {flag} is missing its value")
                value = argv[index + 1]
                index += 2
            check_curl_value(flag, value)
            if flag == "--url":
                urls.append(value)
            continue
        if arg.startswith("-") and len(arg) > 1:
            # A cluster like -sS. Every letter must be a no-argument flag, except
            # the last, which may take the rest of the cluster or the next word.
            letters = arg[1:]
            for position, letter in enumerate(letters):
                short = f"-{letter}"
                if short in CURL_NO_ARG:
                    continue
                if short in CURL_WITH_ARG:
                    rest = letters[position + 1:]
                    if rest:
                        check_curl_value(short, rest)
                        if short == "--url":
                            urls.append(rest)
                        index += 1
                    else:
                        if index + 1 >= len(argv):
                            raise Refused(f"curl flag {short} is missing its value")
                        check_curl_value(short, argv[index + 1])
                        index += 2
                    break
                raise Refused(f"curl flag {short} is not allowed when a credential is involved")
            else:
                index += 1
            continue
        urls.append(arg)
        index += 1

    if len(urls) != 1:
        raise Refused(f"curl must be given exactly one URL (found {len(urls)})")
    parsed = urllib.parse.urlsplit(urls[0])
    if parsed.scheme != "https":
        raise Refused("the URL must be https")
    if "@" in parsed.netloc:
        raise Refused("the URL must not carry credentials in it")
    if parsed.port not in (None, 443):
        raise Refused("the URL must use the default https port")
    host = (parsed.hostname or "").lower()
    if host not in hosts:
        raise Refused(f"{host or 'that URL'} is not an allowed destination (allowed: {', '.join(sorted(hosts))})")


def check_curl_value(flag, value):
    if flag in CURL_DATA_FLAGS and value.startswith("@"):
        raise Refused(f"{flag} @file would send a file from that host; not allowed")
    if flag in ("-H", "--header") and value.startswith("@"):
        raise Refused("reading headers from a file is not allowed")


CHECKERS = {"curl": check_curl}


def check_request(policy, field, argv):
    check_generic(field, argv)
    rule = find_rule(policy, field, argv)
    checker = CHECKERS.get(rule["command"])
    if checker:
        checker(rule, argv)


# --- the vault -------------------------------------------------------------------


class Vault:
    """Reads one field at a time from one Bitwarden item.

    The session key stays in this process's memory: never on disk, never in a
    child's argv (bw takes it from the environment), and dropped after an idle
    period so an unattended laptop does not stay unlocked all day.
    """

    def __init__(self, item, session_ttl):
        self.item = item
        self.session_ttl = session_ttl
        self.lock = threading.Lock()
        self._session = os.environ.get("BW_SESSION") or None
        self._touched = time.monotonic() if self._session else 0.0
        self.bw = shutil.which("bw", path=GUI_PATH) or shutil.which("bw")

    def field(self, name, prompt_title):
        if not self.bw:
            raise RuntimeError("the Bitwarden CLI (bw) is not installed on this machine")
        with self.lock:
            try:
                return self._read(name, prompt_title)
            except PermissionError:
                # The cached session went stale (vault locked elsewhere, or bw
                # restarted). Drop it and ask once more.
                self._session = None
                return self._read(name, prompt_title)

    def _read(self, name, prompt_title):
        session = self._ensure_session(prompt_title)
        result = subprocess.run(
            [self.bw, "get", "item", self.item],
            capture_output=True,
            text=True,
            env={"PATH": GUI_PATH, "HOME": str(HOME), "BW_SESSION": session},
        )
        if result.returncode != 0:
            stderr = result.stderr.strip()
            if "locked" in stderr.lower() or "session" in stderr.lower():
                raise PermissionError(stderr)
            raise RuntimeError(f"bw could not read the item: {stderr}")
        item = json.loads(result.stdout)
        for entry in item.get("fields") or []:
            if entry.get("name") == name:
                value = entry.get("value")
                if not value:
                    raise RuntimeError(f"the field {name} in '{self.item}' is empty")
                return value
        raise RuntimeError(f"'{self.item}' has no field named {name}")

    def _ensure_session(self, prompt_title):
        if self._session and time.monotonic() - self._touched < self.session_ttl:
            self._touched = time.monotonic()
            return self._session
        password = ask_password(
            prompt_title,
            "Unlock the vault to read the field. The master password is not stored.",
        )
        if password is None:
            raise PermissionError("the vault was not unlocked")
        result = subprocess.run(
            [self.bw, "unlock", "--raw", "--passwordenv", "BW_PASSWORD"],
            capture_output=True,
            text=True,
            env={"PATH": GUI_PATH, "HOME": str(HOME), "BW_PASSWORD": password},
        )
        del password
        if result.returncode != 0 or not result.stdout.strip():
            raise PermissionError(result.stderr.strip() or "bw unlock failed")
        self._session = result.stdout.strip()
        self._touched = time.monotonic()
        return self._session


# --- asking me ---------------------------------------------------------------------


def osascript(script, *args, timeout=None):
    return subprocess.run(
        ["/usr/bin/osascript", "-", *args],
        input=script,
        capture_output=True,
        text=True,
        timeout=timeout,
        env={**os.environ, "PATH": GUI_PATH},
    )


NOTIFY = """
on run argv
    display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"
end run
"""

CONFIRM = """
on run argv
    set theTitle to item 1 of argv
    set theBody to item 2 of argv
    set theTimeout to (item 3 of argv) as integer
    tell application "System Events"
        activate
        set theResult to display alert theTitle message theBody as critical ¬
            buttons {"Deny", "Approve"} default button "Deny" cancel button "Deny" ¬
            giving up after theTimeout
    end tell
    if gave up of theResult then
        return "timeout"
    else if button returned of theResult is "Approve" then
        return "approve"
    else
        return "deny"
    end if
end run
"""

PASSWORD = """
on run argv
    tell application "System Events"
        activate
        set theResult to display dialog (item 2 of argv) with title (item 1 of argv) ¬
            default answer "" with hidden answer buttons {"Cancel", "Unlock"} ¬
            default button "Unlock" giving up after 120
    end tell
    if gave up of theResult then error number -128
    return text returned of theResult
end run
"""


def notify(title, message):
    try:
        osascript(NOTIFY, title, message, timeout=10)
    except Exception as exc:  # a missing notification must not block the prompt
        log(f"notification failed: {exc}")


def confirm(title, body, timeout):
    try:
        result = osascript(CONFIRM, title, body, str(timeout), timeout=timeout + 15)
    except subprocess.TimeoutExpired:
        return "timeout"
    answer = result.stdout.strip()
    if answer in ("approve", "deny", "timeout"):
        return answer
    # A cancel button or a dismissed dialog exits non-zero: that is a "no".
    log(f"confirm dialog returned {result.returncode}: {result.stderr.strip()}")
    return "deny"


def ask_password(title, body):
    try:
        result = osascript(PASSWORD, title, body, timeout=150)
    except subprocess.TimeoutExpired:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.rstrip("\n") or None


def quote_argv(argv):
    """Render argv for a human, quoting anything that is not obviously one word."""
    out = []
    for arg in argv:
        if re.fullmatch(r"[\w@%+=:,./-]+", arg or ""):
            out.append(arg)
        else:
            out.append("'" + arg.replace("'", "'\\''") + "'")
    return " ".join(out)


# --- grants and audit ---------------------------------------------------------------


class Grants:
    """An approval covers the identical command from the same session, briefly.

    Without this, iterating on a query prompts ten times in a minute, and prompts
    that arrive constantly stop being read — which would cost more than it buys.
    A different command re-prompts even inside the window.
    """

    def __init__(self, ttl):
        self.ttl = ttl
        self.lock = threading.Lock()
        self.entries = {}

    @staticmethod
    def key(field, argv, session, agent):
        digest = hashlib.sha256(json.dumps(argv, separators=(",", ":")).encode()).hexdigest()
        return (field, digest, session or agent or "")

    def check(self, key):
        if self.ttl <= 0:
            return False
        with self.lock:
            expiry = self.entries.get(key)
            if expiry and expiry > time.monotonic():
                return True
            self.entries.pop(key, None)
            return False

    def grant(self, key):
        if self.ttl <= 0:
            return
        with self.lock:
            self.entries[key] = time.monotonic() + self.ttl
            for stale, expiry in list(self.entries.items()):
                if expiry <= time.monotonic():
                    del self.entries[stale]


class Audit:
    """Every request, decided or refused. Never the value.

    Today an ambient token in an agent's environment leaves no trace of use at
    all, so "what did that agent do with the Datadog token" has no answer. This
    is the answer.
    """

    def __init__(self, path):
        self.path = Path(path).expanduser()
        self.lock = threading.Lock()
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def write(self, **entry):
        entry["ts"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        line = json.dumps(entry, separators=(",", ":"), default=str)
        with self.lock:
            with open(self.path, "a") as handle:
                handle.write(line + "\n")
            os.chmod(self.path, 0o600)
        log(line)


# --- the server ------------------------------------------------------------------------


class Broker:
    def __init__(self, config):
        self.token = config.get("CREDENTIAL_BROKER_TOKEN", "")
        if len(self.token) < 32:
            sys.exit(
                "credential-broker: CREDENTIAL_BROKER_TOKEN is missing or too short "
                "(want >= 32 characters). Generate one with:\n"
                "    python3 -c 'import secrets; print(secrets.token_urlsafe(32))'"
            )
        self.policy = load_policy(config)
        # The name the box asks for is the name the command needs in its
        # environment (pup wants DD_PAT). What that field happens to be called
        # inside the vault item is a separate question, so allow a mapping
        # rather than making the vault dictate the variable name.
        prefix = "CREDENTIAL_BROKER_VAULT_FIELD_"
        self.vault_fields = {k[len(prefix):]: v for k, v in config.items() if k.startswith(prefix)}
        self.grants = Grants(int(config.get("CREDENTIAL_BROKER_GRANT_TTL", 60)))
        self.audit = Audit(config.get("CREDENTIAL_BROKER_AUDIT", DEFAULT_AUDIT))
        self.vault = Vault(
            config.get("CREDENTIAL_BROKER_ITEM", "METR shell env"),
            int(config.get("CREDENTIAL_BROKER_SESSION_TTL", 900)),
        )
        self.prompt_lock = threading.Lock()
        self.recent = deque()
        self.recent_lock = threading.Lock()

    def authenticate(self, header):
        expected = f"Bearer {self.token}"
        return bool(header) and secrets.compare_digest(header, expected)

    def rate_limited(self):
        limit, window = RATE_LIMIT
        now = time.monotonic()
        with self.recent_lock:
            while self.recent and now - self.recent[0] > window:
                self.recent.popleft()
            if len(self.recent) >= limit:
                return True
            self.recent.append(now)
            return False

    def handle(self, request, peer):
        field = request.get("field", "")
        argv = request.get("argv") or []
        agent = str(request.get("agent", ""))[:64]
        session = str(request.get("session", ""))[:64]
        host = str(request.get("host", ""))[:64]
        cwd = str(request.get("cwd", ""))[:512]
        reason = str(request.get("reason", ""))[:512]
        timeout = max(10, min(300, int(request.get("timeout", 120) or 120)))
        entry = dict(peer=peer, host=host, agent=agent, session=session, field=field,
                     argv=argv, cwd=cwd, reason=reason)

        if not isinstance(field, str) or not re.fullmatch(r"[A-Z][A-Z0-9_]*", field):
            self.audit.write(decision="refused", why="bad field name", **entry)
            return 403, {"error": "bad field name"}

        try:
            check_request(self.policy, field, argv)
        except Refused as refusal:
            self.audit.write(decision="refused", why=str(refusal), **entry)
            return 403, {"error": str(refusal)}

        key = Grants.key(field, argv, session, agent)
        if self.grants.check(key):
            self.audit.write(decision="approved", why="existing grant", **entry)
            return self.release(field, entry, grant=True)

        if self.rate_limited():
            self.audit.write(decision="refused", why="rate limited", **entry)
            return 429, {"error": "too many requests to this broker; nobody is being prompted"}

        title = f"{field} requested by {agent or 'an agent'}"
        body = "\n".join(filter(None, [
            f"{host or 'a remote host'} wants to run:",
            "",
            f"    {quote_argv(argv)}",
            "",
            f"in {cwd}" if cwd else "",
            f"Reason given: {reason}" if reason else "No reason given.",
            "",
            f"Approving puts {field} in that command's environment on {host or 'that host'}.",
        ]))

        # One prompt at a time; a queue of dialogs is how a person ends up
        # clicking through without reading.
        if not self.prompt_lock.acquire(timeout=timeout):
            self.audit.write(decision="refused", why="another prompt was already open", **entry)
            return 408, {"error": "another approval was already waiting"}
        try:
            notify("Credential request", f"{field} for {agent or 'an agent'} on {host}")
            answer = confirm(title, body, timeout)
        finally:
            self.prompt_lock.release()

        if answer == "timeout":
            self.audit.write(decision="timeout", **entry)
            return 408, {"error": "nobody answered the approval prompt"}
        if answer != "approve":
            self.audit.write(decision="denied", **entry)
            return 403, {"error": "denied at the laptop"}

        self.grants.grant(key)
        self.audit.write(decision="approved", why="human approved", **entry)
        return self.release(field, entry, grant=False)

    def release(self, field, entry, grant):
        try:
            value = self.vault.field(self.vault_fields.get(field, field),
                                     f"Unlock the vault to release {field}")
        except PermissionError as exc:
            self.audit.write(decision="failed", why=f"vault locked: {exc}", **entry)
            return 403, {"error": "the vault was not unlocked at the laptop"}
        except Exception as exc:
            self.audit.write(decision="failed", why=str(exc), **entry)
            return 500, {"error": f"could not read the field: {exc}"}
        return 200, {"value": value, "ttl": self.grants.ttl if not grant else 0}


class Handler(BaseHTTPRequestHandler):
    broker = None
    server_version = "credential-broker"
    sys_version = ""

    def _send(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        # Unauthenticated on purpose, and it says nothing: the box needs to tell
        # "the laptop is asleep" apart from "my token is wrong" so it can tell a
        # human which one it is.
        if self.path == "/health":
            self._send(200, {"ok": True})
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/request":
            self._send(404, {"error": "not found"})
            return
        if not self.broker.authenticate(self.headers.get("Authorization", "")):
            log(f"rejected an unauthenticated request from {self.client_address[0]}")
            self._send(401, {"error": "bad bearer token"})
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            if length > 64 * 1024:
                self._send(400, {"error": "request too large"})
                return
            request = json.loads(self.rfile.read(length))
            if not isinstance(request, dict):
                raise ValueError("not an object")
        except Exception:
            self._send(400, {"error": "malformed request"})
            return
        try:
            code, payload = self.broker.handle(request, self.client_address[0])
        except Exception as exc:  # never leak a traceback to the box
            log(f"internal error: {exc!r}")
            self._send(500, {"error": "internal error at the broker"})
            return
        self._send(code, payload)

    def log_message(self, *_):
        pass


def tailnet_address():
    """Bind the tailnet interface, never 0.0.0.0.

    url-listener next door binds every interface with no authentication at all;
    that is not a pattern to copy for something that hands out credentials.
    """
    tailscale = shutil.which("tailscale", path=GUI_PATH) or "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
    try:
        result = subprocess.run([tailscale, "ip", "-4"], capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    if result.returncode != 0:
        return None
    for line in result.stdout.split():
        if line.count(".") == 3:
            return line.strip()
    return None


def main():
    parser = argparse.ArgumentParser(description="Broker one vault field to one remote command")
    parser.add_argument("--port", type=int)
    parser.add_argument("--bind")
    parser.add_argument("--check", action="store_true",
                        help="validate the configuration and policy, then exit")
    parser.add_argument("--test-field", metavar="NAME",
                        help="read one field from the vault and report whether it is there, "
                             "without printing it or serving anything")
    args = parser.parse_args()

    config = read_config()
    broker = Broker(config)
    port = args.port or int(config.get("CREDENTIAL_BROKER_PORT", 7078))
    bind = args.bind or config.get("CREDENTIAL_BROKER_BIND") or tailnet_address()

    if not bind:
        sys.exit(
            "credential-broker: could not work out this machine's tailnet address, and I will\n"
            "not fall back to binding every interface. Start tailscaled, or set\n"
            "CREDENTIAL_BROKER_BIND to the address the agent host reaches me on."
        )
    if bind in ("0.0.0.0", "::", ""):
        sys.exit("credential-broker: refusing to bind every interface; name an address.")

    if args.test_field:
        name = broker.vault_fields.get(args.test_field, args.test_field)
        try:
            value = broker.vault.field(name, f"Unlock the vault to check for {name}")
        except Exception as exc:
            print(f"no: {exc}")
            return 1
        # The length and nothing else: enough to confirm it is the right field
        # and not a stale or empty one.
        print(f"ok: '{broker.vault.item}' has a field {name!r} of {len(value)} characters")
        if name != args.test_field:
            print(f"    released to the box as {args.test_field}")
        return 0

    if args.check:
        print(f"config    {CONFIG_PATH}")
        print(f"bind      {bind}:{port}")
        print(f"item      {broker.vault.item}")
        print(f"bw        {broker.vault.bw or 'NOT FOUND'}")
        print(f"audit     {broker.audit.path}")
        print(f"grant ttl {broker.grants.ttl}s")
        for field, rules in sorted(broker.policy.items()):
            for rule in rules:
                extra = f" -> {', '.join(rule['hosts'])}" if rule.get("hosts") else ""
                print(f"allow     {field}: {rule['command']}{extra}")
        for name, vault_name in sorted(broker.vault_fields.items()):
            print(f"field     {name} <- {vault_name!r} in the vault item")
        print("\nCheck the vault actually has the field, without printing it:")
        print(f"    {sys.argv[0]} --test-field {sorted(broker.policy)[0] if broker.policy else 'FIELD'}")
        return 0

    Handler.broker = broker
    server = ThreadingHTTPServer((bind, port), Handler)
    log(f"credential-broker listening on {bind}:{port}")
    try:
        server.serve_forever(poll_interval=0.2)
    except KeyboardInterrupt:
        pass
    server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
