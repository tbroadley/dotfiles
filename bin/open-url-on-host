#!/bin/bash
# Opens a URL on the host machine by sending it to the url-listener.
# Used as BROWSER in dev containers to forward URLs to host browser; also works
# from a remote host that can reach the laptop (see url-listener-url).

# Sibling scripts live next to this one, wherever it was symlinked from.
_bindir="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd)"

URL="$1"
if [ -z "$URL" ]; then
    exit 1
fi

BASE="$("$_bindir/url-listener-url")" || exit 1
TOKEN="$("$_bindir/url-listener-token")" || exit 1
ENCODED_URL=$(printf '%s' "$URL" | jq -sRr @uri)

# The token goes through a curl config file on /dev/fd, not argv, so it does not
# show up in `ps` for every process on this host.
curl -sf -K <(printf 'header = "Authorization: Bearer %s"\n' "$TOKEN") \
    "${BASE}/open?url=${ENCODED_URL}" >/dev/null 2>&1 &
