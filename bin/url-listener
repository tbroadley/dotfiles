#!/usr/bin/env python3
"""
Simple HTTP server that listens for requests from dev containers.
- Opens URLs in the default browser on the host
- Opens files/directories in Cursor (attached to the dev container)
- Opens files in Preview on the host
- Clipboard forwarding (pbcopy/pbpaste) between container and host

Every endpoint except /health needs a bearer token. The tailnet is not a
single-user network — it is the whole org — and these endpoints read the host
clipboard, open things on the host, and drive the host's UI. Being reachable
only from the tailnet is a smaller blast radius than every interface, not an
authorisation decision. credential-broker next door already works this way.

Usage: url-listener [--port PORT]
Default port: 7077

Configuration, ~/.config/url-listener.env (mode 0600), environment wins:

    URL_LISTENER_TOKEN=<shared bearer token, >= 32 chars>
    URL_LISTENER_PORT=7077

Clients resolve the same token through bin/url-listener-token.
"""

import argparse
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import threading
import urllib.parse
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from pathlib import Path

# A connection that goes quiet is dropped rather than held forever. Without
# this, one socket that opens and never finishes its request line hangs the
# whole server: the read blocks before any routing or token check happens, so
# it costs an attacker nothing and no credential.
CONNECTION_TIMEOUT = 30

# The clipboard is text. Generous for a paste, bounded so a declared
# Content-Length cannot ask the server to read something enormous.
MAX_COPY_BYTES = 16 * 1024 * 1024

CONFIG_PATH = Path(os.environ.get("URL_LISTENER_CONFIG", Path.home() / ".config/url-listener.env"))


CURSOR_CONTAINER_CONFIG_DIR = Path.home() / "Library/Application Support/Cursor/User/globalStorage/anysphere.remote-containers/nameConfigs"

# What Docker itself accepts as a container name or id. Everything reaching this
# server comes off a query string, so a name is checked before it is used as a
# path component or handed to `docker inspect`.
CONTAINER_NAME = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}")


# /open hands its argument to `/usr/bin/open`, which is not a browser: it acts on
# filesystem paths and on every URL scheme the machine has a handler for, so it
# will launch an application, open a `.command` file, or drive something like
# `x-apple.systempreferences:`. Every caller here sends a web URL — BROWSER for a
# dev container, the AWS SSO device page — so that is all this accepts.
OPENABLE_SCHEMES = {"http", "https"}


def openable(url: str) -> bool:
    try:
        parsed = urllib.parse.urlsplit(url)
    except ValueError:
        return False
    # A hostname is required too: "https:///etc/passwd" parses with the right
    # scheme and no host, and `open` would treat what is left as a local path.
    return parsed.scheme.lower() in OPENABLE_SCHEMES and bool(parsed.netloc)


def read_config():
    """Environment first, then the config file. Refuses a loose file mode."""
    config = {}
    if CONFIG_PATH.is_file():
        if CONFIG_PATH.stat().st_mode & 0o077:
            sys.exit(
                f"url-listener: {CONFIG_PATH} is group- or world-readable and holds a\n"
                f"bearer token. Run: chmod 600 {CONFIG_PATH}"
            )
        for line in CONFIG_PATH.read_text().splitlines():
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip()
    config.update({k: v for k, v in os.environ.items() if k.startswith("URL_LISTENER_")})
    return config


def valid_container_name(name: str) -> bool:
    """A container name, and nothing that is really a path or a flag.

    `container` used to go straight into f"{name}.json" under the Cursor config
    dir, so a name of `../../../../tmp/x` wrote an attacker-shaped JSON file
    anywhere the user could write — ~/.claude/settings.json, say. The leading
    character class also keeps a name from starting with `-` and being read as
    an option by `docker inspect`.
    """
    return bool(CONTAINER_NAME.fullmatch(name))

# Environment for launching GUI apps - launchd has minimal PATH
GUI_ENV = {
    **os.environ,
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
}


def executable_path(name: str) -> str:
    path = shutil.which(name, path=GUI_ENV["PATH"])
    assert path is not None, f"Could not find executable: {name}"
    return path


def map_container_path_to_host(container_name: str, container_path: str) -> Path:
    result = subprocess.run(
        [executable_path("docker"), "inspect", container_name],
        capture_output=True,
        text=True,
        check=True,
        env=GUI_ENV,
    )
    inspect_data = json.loads(result.stdout)[0]

    container_path_obj = Path(container_path)
    mounts = inspect_data["Mounts"]
    matching_mounts = sorted(
        (
            mount
            for mount in mounts
            if container_path_obj == Path(mount["Destination"])
            or container_path_obj.is_relative_to(Path(mount["Destination"]))
        ),
        key=lambda mount: len(mount["Destination"]),
        reverse=True,
    )
    assert matching_mounts, f"No mount found for container path {container_path}"

    mount = matching_mounts[0]
    destination = Path(mount["Destination"])
    source = Path(mount["Source"])
    relative_path = container_path_obj.relative_to(destination)
    host_path = source / relative_path
    assert host_path.exists(), f"Mapped host path does not exist: {host_path}"
    return host_path


def write_container_config(
    container_name: str,
    extensions: list[str],
    settings: dict | None = None,
    remote_user: str | None = None,
) -> None:
    """Write extensions and settings to Cursor's attached container config file."""
    CURSOR_CONTAINER_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    config_path = CURSOR_CONTAINER_CONFIG_DIR / f"{container_name}.json"
    # The handler validated the name; this is the sink, so it says so too. A
    # future caller that forgets the check gets an error, not a file written
    # somewhere else.
    if config_path.parent.resolve() != CURSOR_CONTAINER_CONFIG_DIR.resolve():
        raise ValueError(f"container name escapes the config directory: {container_name!r}")
    # Use provided settings from devcontainer.json, default to empty dict
    config_settings = settings if settings else {}
    # Ensure python.defaultInterpreterPath is set if not specified
    config_settings.setdefault("python.defaultInterpreterPath", "/opt/python/bin/python3")
    config = {
        "extensions": extensions,
        "settings": config_settings,
    }
    if remote_user:
        config["remoteUser"] = remote_user
    config_path.write_text(json.dumps(config, indent=2) + "\n")


class URLHandler(BaseHTTPRequestHandler):
    token = ""
    timeout = CONNECTION_TIMEOUT

    def authenticated(self, parsed):
        """/health is open on purpose; everything else needs the bearer token.

        A caller needs to tell "the laptop is asleep" apart from "my token is
        wrong" without holding a credential, and /health says nothing but "up".
        """
        if parsed.path == "/health":
            return True
        header = self.headers.get("Authorization", "")
        if secrets.compare_digest(header, f"Bearer {self.token}"):
            return True
        self.log_message("REJECTED unauthenticated %s %s", self.command, parsed.path)
        self.send_response(401)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(b"bad bearer token\n")
        return False

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)

        if not self.authenticated(parsed):
            return

        if parsed.path == "/open" and "url" in params:
            url = params["url"][0]
            if not openable(url):
                self.log_message("REFUSED /open for a non-web URL")
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"only http and https URLs can be opened")
                return
            subprocess.run(["/usr/bin/open", url], check=False)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        elif parsed.path == "/cursor" and "container" in params and "path" in params:
            container_name = params["container"][0]
            if not valid_container_name(container_name):
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"Invalid container name")
                return
            paths = params["path"]
            is_file = params.get("file", ["0"])[0] == "1"
            extensions_param = params.get("extensions", [""])[0]
            settings_param = params.get("settings", ["{}"])[0]
            remote_user = params.get("user", [None])[0]
            extensions = [e.strip() for e in extensions_param.split(",") if e.strip()] if extensions_param else []
            try:
                settings = json.loads(settings_param) if settings_param else {}
            except json.JSONDecodeError:
                settings = {}
            write_container_config(container_name, extensions, settings, remote_user)
            config = json.dumps({"containerName": f"/{container_name}"})
            hex_config = config.encode().hex()
            cursor_path = executable_path("cursor")
            if is_file:
                cmd = [cursor_path, "--new-window"]
                for p in paths:
                    cmd.extend(["--file-uri", f"vscode-remote://attached-container+{hex_config}{p}"])
                subprocess.run(cmd, check=False, env=GUI_ENV)
            else:
                uri = f"vscode-remote://attached-container+{hex_config}{paths[0]}"
                subprocess.run([cursor_path, "--new-window", "--folder-uri", uri], check=False, env=GUI_ENV)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        elif parsed.path == "/preview" and "container" in params and "path" in params:
            container_name = params["container"][0]
            if not valid_container_name(container_name):
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"Invalid container name")
                return
            try:
                host_paths = [map_container_path_to_host(container_name, path) for path in params["path"]]
                subprocess.run(["/usr/bin/open", "-a", "Preview", *[str(path) for path in host_paths]], check=False, env=GUI_ENV)
                self.send_response(200)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"OK")
            except Exception as exc:
                self.send_response(500)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(str(exc).encode())
        elif parsed.path == "/wispr-dictionary":
            phrase = params.get("phrase", [""])[0]
            replacement = params.get("replacement", [None])[0]
            is_snippet = params.get("snippet", ["0"])[0] == "1"
            no_refresh = params.get("no_refresh", ["0"])[0] == "1"
            if not phrase:
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"Missing phrase parameter")
                return
            cmd = [str(Path.home() / "dotfiles/bin/wispr-add-dictionary"), phrase]
            if replacement:
                cmd.append(replacement)
            if is_snippet:
                cmd.insert(1, "--snippet")
            if no_refresh:
                cmd.insert(1, "--no-refresh")
            result = subprocess.run(cmd, capture_output=True, text=True)
            self.send_response(200 if result.returncode == 0 else 500)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write((result.stdout + result.stderr).encode())
        elif parsed.path == "/paste":
            result = subprocess.run(["/usr/bin/pbpaste"], capture_output=True)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(result.stdout)
        elif parsed.path == "/notify":
            title = params.get("title", ["Claude Code"])[0]
            message = params.get("message", [""])[0]
            sound = params.get("sound", [""])[0]
            if not message:
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"Missing message parameter")
                return
            script = f'display notification {json.dumps(message)} with title {json.dumps(title)}'
            if sound:
                script += f' sound name {json.dumps(sound)}'
            subprocess.run(["/usr/bin/osascript", "-e", script], check=False)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        elif parsed.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if not self.authenticated(parsed):
            return
        if parsed.path == "/copy":
            # A header is not a promise. Both a non-numeric Content-Length and
            # an enormous one used to reach rfile.read() and raise, which
            # socketserver turned into a traceback and a dropped connection
            # rather than an answer.
            try:
                content_length = int(self.headers.get("Content-Length", 0))
            except ValueError:
                content_length = -1
            if not 0 <= content_length <= MAX_COPY_BYTES:
                self.send_response(400)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(f"Content-Length must be 0..{MAX_COPY_BYTES}\n".encode())
                return
            body = self.rfile.read(content_length)
            subprocess.run(["/usr/bin/pbcopy"], input=body, check=False)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        else:
            self.send_response(404)
            self.end_headers()

    # No log_message override. This used to be `pass`, which meant that when the
    # server was bound to 0.0.0.0 and reachable from any network the laptop
    # joined, there was no record of a single request — so "was that abused for
    # the months it was exposed?" had no answer. The default logs peer, request
    # line and status to stderr, which the launchd plist keeps in
    # ~/Library/Logs/url-listener.log.
    #
    # Query strings are logged (that is where /open's URL is, which is the part
    # worth having); clipboard bodies are not, since they never appear in one.


def tailnet_address():
    """This machine's tailnet IPv4, or None when tailscaled isn't up."""
    tailscale = shutil.which("tailscale", path=GUI_ENV["PATH"]) or "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
    try:
        result = subprocess.run([tailscale, "ip", "-4"], capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    if result.returncode != 0:
        return None
    for line in result.stdout.split():
        if line.count(".") == 3:
            return line.strip()
    return None


def bind_addresses():
    """Loopback and the tailnet, never every interface.

    This used to bind 0.0.0.0, which put /paste — the host clipboard — and
    /open on every network the laptop joined, unauthenticated. Anyone on the
    same cafe wifi could read whatever was last copied.

    Loopback covers dev containers: Docker Desktop forwards
    host.docker.internal to the host's 127.0.0.1. The tailnet address covers
    remote hosts. Nothing else has any business here.
    """
    addresses = ["127.0.0.1"]
    tailnet = tailnet_address()
    if tailnet:
        addresses.append(tailnet)
    else:
        print("url-listener: no tailnet address; listening on loopback only.", file=sys.stderr)
    return addresses


def main():
    parser = argparse.ArgumentParser(description="URL listener for dev containers")
    parser.add_argument("--port", type=int, help="Port to listen on")
    args = parser.parse_args()

    config = read_config()
    URLHandler.token = config.get("URL_LISTENER_TOKEN", "")
    if len(URLHandler.token) < 32:
        sys.exit(
            "url-listener: URL_LISTENER_TOKEN is missing or too short (want >= 32 characters).\n"
            f"These endpoints read the clipboard and drive the host, and the tailnet is the whole\n"
            f"org, so there is no unauthenticated mode. Set one up with:\n\n"
            f"    umask 077 && printf 'URL_LISTENER_TOKEN=%s\\n' \\\n"
            f"        \"$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')\" \\\n"
            f"        >> {CONFIG_PATH}\n"
        )
    port = args.port or int(config.get("URL_LISTENER_PORT", 7077))

    servers = []
    for address in bind_addresses():
        # Threaded, so one slow handler — `docker inspect` for /preview, say —
        # cannot stall every other request the way the single-threaded server
        # did. credential-broker has always used the threading server.
        server = ThreadingHTTPServer((address, port), URLHandler, bind_and_activate=False)
        server.daemon_threads = True
        server.allow_reuse_address = True
        server.server_bind()
        server.server_activate()
        servers.append(server)

    def stop(*_):
        for server in servers:
            threading.Thread(target=server.shutdown).start()

    signal.signal(signal.SIGTERM, stop)
    bound = ", ".join(f"{s.server_address[0]}:{port}" for s in servers)
    print(f"URL listener started on {bound}", file=sys.stderr)

    threads = [threading.Thread(target=s.serve_forever, kwargs={"poll_interval": 0.1}, daemon=True)
               for s in servers[1:]]
    for thread in threads:
        thread.start()
    try:
        servers[0].serve_forever(poll_interval=0.1)
    except KeyboardInterrupt:
        stop()
    for thread in threads:
        thread.join(timeout=5)
    for server in servers:
        server.server_close()


if __name__ == "__main__":
    main()
