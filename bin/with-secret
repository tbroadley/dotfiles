#!/usr/bin/env bash
# Run one command with one credential in its environment, without ever showing
# the credential to whoever asked for it.
#
#     with-secret DD_PAT -- pup metrics query 'avg:system.cpu.user{*}'
#
# The credential does not live on this host. It lives in a vault on my laptop,
# behind a broker that authenticates the request, checks the command against an
# allowlist it owns, asks me to approve it, and decrypts exactly one field. This
# script gets the value back over the private network, puts it in the *child
# process's* environment, runs the command, scrubs the literal value out of the
# child's output, and forgets it. Nothing is written to disk and nothing about
# the value is ever printed.
#
# Why not a `secret get NAME` that prints the value: the caller here is usually
# an agent whose entire input and output is recorded in a session transcript. A
# printed secret is a permanently disclosed secret. So there is deliberately no
# way to obtain a value with this tool - only to have a command run with it.
#
# The allowlist of which commands may see which field is enforced by the broker,
# not here, so that editing this file buys you nothing.
#
# Usage: with-secret [OPTIONS] FIELD -- COMMAND [ARG...]
#
#   --reason TEXT    shown on the approval prompt; say what you are doing
#   --timeout SECS   how long to wait for approval (default 120)
#
# Exit codes: the command's own exit status when the command ran at all.
# Otherwise, with an explanation on stderr:
#   2       the broker is unreachable - laptop asleep, off the network, or the
#           service is down. Nobody can approve anything. Do NOT retry in a loop.
#   3       refused: the command is not on the allowlist for this field, the
#           bearer token was rejected, or a human said no.
#   4       nobody answered the approval prompt in time.
#   64      usage error
#   78      configuration error on this host
#
# Configuration, in the same shape as url-listener-url. Resolution order:
#   1. $CREDENTIAL_BROKER_URL                 full base URL, wins outright
#   2. $CREDENTIAL_BROKER_HOST (+ _PORT)      host or IP, combined with the port
#   3. ~/.config/credential-broker.env        KEY=VALUE lines for the above,
#                                             plus CREDENTIAL_BROKER_TOKEN
# The bearer token authorises *raising a prompt*, nothing more; losing it costs
# prompt spam, not credentials. It still wants mode 0600.

set -uo pipefail

config="${CREDENTIAL_BROKER_CONFIG:-$HOME/.config/credential-broker.env}"
base="${CREDENTIAL_BROKER_URL:-}"
host="${CREDENTIAL_BROKER_HOST:-}"
port="${CREDENTIAL_BROKER_PORT:-}"
token="${CREDENTIAL_BROKER_TOKEN:-}"
reason=""
timeout="${WITH_SECRET_TIMEOUT:-120}"

die() { printf 'with-secret: %s\n' "$1" >&2; exit "${2:-1}"; }

usage() {
    cat <<'EOF'
Usage: with-secret [--reason TEXT] [--timeout SECS] FIELD -- COMMAND [ARG...]

Run COMMAND with the vault field FIELD in its environment, after a human on the
laptop approves it. The value is never printed and never written to disk.

  with-secret DD_PAT -- pup metrics query 'avg:system.cpu.user{*}'

Which commands may see which field is decided by the broker on the laptop, not
by this host. Shell wrappers (sh, bash, env, xargs, ...) are refused, so there
is no way to turn this into a general "give me the secret".
EOF
}

field=""
while [ $# -gt 0 ]; do
    case "$1" in
        --reason) reason="${2:?--reason needs a value}"; shift 2 ;;
        --timeout) timeout="${2:?--timeout needs a value}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage >&2; die "unknown option $1" 64 ;;
        *)
            [ -n "$field" ] && { usage >&2; die "unexpected argument '$1' (did you forget the -- before the command?)" 64; }
            field="$1"; shift ;;
    esac
done

[ -n "$field" ] || { usage >&2; die "no field named" 64; }
[ $# -gt 0 ] || { usage >&2; die "no command given after --" 64; }
case "$field" in
    [A-Z]*) [[ "$field" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "'$field' is not a valid field name" 64 ;;
    *) die "'$field' is not a valid field name" 64 ;;
esac
[[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout wants a whole number of seconds" 64

for tool in curl jq; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required but not installed" 78
done

# --- where is the broker, and what do we authenticate with ---------------------

if [ -f "$config" ]; then
    perms="$(stat -c '%a' "$config" 2>/dev/null || stat -f '%Lp' "$config" 2>/dev/null || echo '')"
    case "$perms" in
        ''|*00) : ;;
        *) die "$config is mode $perms; it holds a bearer token, so run: chmod 600 $config" 78 ;;
    esac
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        case "$line" in
            CREDENTIAL_BROKER_URL=*)   [ -n "$base" ]  || base="${line#*=}" ;;
            CREDENTIAL_BROKER_HOST=*)  [ -n "$host" ]  || host="${line#*=}" ;;
            CREDENTIAL_BROKER_PORT=*)  [ -n "$port" ]  || port="${line#*=}" ;;
            CREDENTIAL_BROKER_TOKEN=*) [ -n "$token" ] || token="${line#*=}" ;;
        esac
    done < "$config"
fi

if [ -z "$base" ] && [ -n "$host" ]; then
    base="http://$host:${port:-7078}"
fi
base="${base%/}"

if [ -z "$base" ]; then
    cat >&2 <<EOF
with-secret: don't know where the credential broker is.
Set CREDENTIAL_BROKER_HOST (or CREDENTIAL_BROKER_URL) in the environment, or
write it to $config:

    CREDENTIAL_BROKER_HOST=<hostname or IP of the machine running the broker>
    CREDENTIAL_BROKER_TOKEN=<shared bearer token>
EOF
    exit 78
fi
[ -n "$token" ] || die "no bearer token; set CREDENTIAL_BROKER_TOKEN in $config" 78
# Keeps the token safe to hand to curl through a config file, and catches a
# mangled config line before it becomes a confusing 401.
[[ "$token" =~ ^[A-Za-z0-9_.=+/~-]{16,}$ ]] || die "the bearer token in $config does not look like a token" 78

# --- ask ----------------------------------------------------------------------

# Fail the same way aws-sso-login does when the laptop is not there: say so
# plainly, and say not to keep trying.
if ! curl -sf --max-time 5 "$base/health" >/dev/null 2>&1; then
    cat >&2 <<EOF
with-secret: the credential broker at $base is not answering.
$field lives in a vault on my laptop and there is no copy on this host, so
without the broker there is no way to get it and no way to ask anyone. The
laptop is probably asleep or off the network.
Report this and stop; do not retry in a loop.
EOF
    exit 2
fi

agent="${PIROUETTE_AGENT:-}"
if [ -z "$agent" ] && [ -n "${PI_SESSION_FILE:-}" ]; then
    agent="$(basename "$(dirname "$PI_SESSION_FILE")")"
fi

request="$(jq -n \
    --arg field "$field" \
    --arg cwd "$PWD" \
    --arg host "$(hostname)" \
    --arg agent "${agent:-unknown}" \
    --arg session "${PI_SESSION_ID:-}" \
    --arg reason "$reason" \
    --argjson timeout "$timeout" \
    --args '{
        field: $field, argv: $ARGS.positional, cwd: $cwd, host: $host,
        agent: $agent, session: $session, reason: $reason, timeout: $timeout
    }' -- "$@")" || die "could not build the request" 1

# The bearer token goes to curl through a config file on /dev/fd rather than in
# argv, where any process on this host could read it out of `ps`.
response="$(printf '%s' "$request" | curl -sS \
    --max-time "$((timeout + 15))" \
    -K <(printf 'header = "Authorization: Bearer %s"\n' "$token") \
    -H 'Content-Type: application/json' \
    --data-binary @- \
    -w '\n%{http_code}' \
    "$base/request" 2>/dev/null)"
curl_rc=$?

if [ "$curl_rc" -ne 0 ]; then
    cat >&2 <<EOF
with-secret: lost contact with the broker at $base while waiting (curl $curl_rc).
Report this and stop; do not retry in a loop.
EOF
    exit 2
fi

code="${response##*$'\n'}"
body="${response%$'\n'*}"
broker_error() {
    local msg
    msg="$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)"
    printf '%s' "${msg:-no explanation given}"
}

case "$code" in
    200) : ;;
    401|403)
        cat >&2 <<EOF
with-secret: the broker refused this request: $(broker_error)
The allowlist of which commands may use $field lives on the laptop and cannot be
changed from this host. If the command is a legitimate use, ask me to add it
rather than looking for a way around this.
EOF
        exit 3 ;;
    408|504)
        cat >&2 <<EOF
with-secret: nobody approved the request for $field within ${timeout}s.
The prompt went to the laptop and went unanswered. Stop and report; do not retry
in a loop.
EOF
        exit 4 ;;
    *)
        die "the broker answered HTTP $code: $(broker_error)" 1 ;;
esac

value="$(printf '%s' "$body" | jq -r '.value // empty' 2>/dev/null)"
[ -n "$value" ] || die "the broker approved the request but returned no value" 1
# Below this length the scrubber would start eating unrelated text, and no real
# credential is this short, so treat it as a broken vault field rather than
# running with something we cannot safely redact.
[ "${#value}" -ge 8 ] || die "the broker returned an implausibly short value for $field" 3

# --- run ----------------------------------------------------------------------

mask="<$field redacted>"

# Redact the literal value from a stream. In-process on purpose: the value stays
# a shell variable and never becomes another process's argv or environment.
# Line-oriented, so it does not help with binary output, and it cannot catch a
# value the child has re-encoded (base64, URL-escaped) before printing.
scrub() {
    local line
    while IFS= read -r line; do
        printf '%s\n' "${line//"$value"/$mask}"
    done
    [ -n "${line:-}" ] && printf '%s' "${line//"$value"/$mask}"
    return 0
}

# Only the exit status touches disk; the value never does.
rcfile="$(mktemp "${TMPDIR:-/tmp}/with-secret.XXXXXX")"
trap 'rm -f "$rcfile"' EXIT

# The export happens in a subshell that immediately execs, so FIELD is in the
# child's environment and never in this process's. stdout and stderr each go
# through the scrubber and stay separate streams.
{
    {
        ( export "$field=$value"; exec 4>&-; exec "$@" )
        printf '%s' "$?" > "$rcfile"
    } 2>&1 1>&4 | scrub >&2
} 4>&1 | scrub

rc="$(cat "$rcfile" 2>/dev/null)"
[ -n "$rc" ] || rc=127
exit "$rc"
