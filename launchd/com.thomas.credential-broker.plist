<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thomas.credential-broker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/thomas/dotfiles/bin/credential-broker</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- The approval dialog and the unlock prompt are AppleScript, so this has
         to be a LaunchAgent in the GUI session, not a LaunchDaemon. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/thomas/Library/Logs/credential-broker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thomas/Library/Logs/credential-broker.log</string>
</dict>
</plist>
