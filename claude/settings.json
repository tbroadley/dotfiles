{
  "cleanupPeriodDays": 999999,
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(dd:*)",
      "Bash(/bin/dd:*)",
      "Bash(/usr/bin/dd:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*:*)",
      "Bash(/sbin/mkfs:*)",
      "Bash(truncate:*)",
      "Bash(/usr/bin/truncate:*)",
      "Bash(sudo:*)",
      "Bash(/usr/bin/sudo:*)",
      "Bash(doas:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/app",
      "~/dotfiles",
      "~/.worktrees"
    ]
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-branch-freshness.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-secrets-scan.sh",
            "timeout": 120000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "warehouse-query@metr-eval-execution": true,
    "hugging-face-cli@huggingface-skills": false,
    "hugging-face-datasets@huggingface-skills": false,
    "slack@claude-plugins-official": false,
    "metr-security@metr-claude-code": true
  },
  "extraKnownMarketplaces": {
    "metr-claude-code": {
      "source": {
        "source": "github",
        "repo": "METR/claude-code"
      }
    }
  },
  "effortLevel": "medium",
  "fastMode": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "light"
}
